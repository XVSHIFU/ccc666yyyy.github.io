---
import { ArrowUpRight } from '@lucide/astro';
import { categoryUrl, formatDate, getPostUrl, readingTime, tagUrl, type Post } from '../lib/content';
import { url } from '../lib/site';

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const { data } = post;
---
<article class:list={['post-card', { 'post-card-featured': featured }]} data-category={data.category}>
  {data.cover && <a class="post-cover" href={getPostUrl(post)} tabindex="-1" aria-hidden="true">
    <img src={url(data.cover)} alt="" width="800" height="500" loading={featured ? 'eager' : 'lazy'} decoding="async" />
  </a>}
  <div class="post-card-body">
    <div class="post-meta">
      <a class="post-category" href={categoryUrl(data.category)}>{data.category}</a>
      <time datetime={data.published.toISOString()}>{formatDate(data.published, true)}</time>
      {data.example && <span class="example-badge">示例</span>}
    </div>
    <h3 class="post-card-title"><a href={getPostUrl(post)}>{data.title}</a></h3>
    <p class="post-excerpt">{data.description}</p>
    <div class="post-card-footer">
      <div class="post-tags">{data.tags.slice(0, 2).map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div>
      <a class="post-read-link" href={getPostUrl(post)} aria-label={`阅读：${data.title}`}>
        <span>{readingTime(post.body)}</span><ArrowUpRight size={17} aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
