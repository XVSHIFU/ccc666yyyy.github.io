---
import { House, Archive, Folder, Tags, CodeXml, Mail, Rss, CalendarDays, Clock3, ChevronRight, BookOpen, Files, UserRound, ArrowUpRight } from '@lucide/astro';
import { getPosts, getPostUrl, formatDate, readingTime, categoryUrl, tagUrl } from '../../lib/content';
import { site, url } from '../../lib/site';
const posts = await getPosts();
const categories = [...new Set(posts.map(post => post.data.category))];
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<section class="f-banner" aria-labelledby="firefly-title">
  <img class="f-banner-art" src={url('/media/landscape.webp')} alt="" width="1983" height="793" fetchpriority="high" decoding="async"/>
  <div class="f-banner-copy"><h1 id="firefly-title">{site.title}</h1><p><reference-typewriter data-text={JSON.stringify(site.description.match(/[^，。]+[，。]?/gu))} data-fallback={site.description} data-speed="100" data-delete="50" data-pause="2000"><span class="f-text-measure" aria-hidden="true">{site.description}</span><span class="f-typed" data-typed-output aria-hidden="true">{site.description}</span><span class="sr-only">{site.description}</span></reference-typewriter></p><div class="f-banner-links"><a href={site.github} target="_blank" rel="noopener noreferrer"><CodeXml size={18}/>GitHub</a><a href={`mailto:${site.email}`} aria-label="发送邮件"><Mail size={19}/></a><a href={url('about/')} aria-label="关于 qinghe"><UserRound size={19}/></a><a href={url('rss.xml')} aria-label="RSS 订阅"><Rss size={19}/></a></div></div>
  <svg class="f-waves" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">{[0, 13, 22, 30].map((offset, index) => <path style={`--wave-y:${offset}px;--wave-duration:${8 + index}s;--wave-delay:${[0, -2.25, -5, -8.25][index]}s;--wave-opacity:${[.25,.5,.65,.75][index]}`} d={`M-1680 65 ${Array.from({length: 126}, (_, step) => { const x = -1680 + (step + 1) * 40; return `L${x} ${(65 + Math.sin(x / 1680 * Math.PI * 2) * 63).toFixed(2)}`; }).join(' ')} V250 H-1680Z`}/>)}</svg>
</section>
<div class="f-layout">
  <aside class="f-left" aria-label="作者与分类">
    <section class="f-profile f-panel"><a class="f-avatar" href={url('about/')} aria-label="关于 qinghe"><img src={url('/media/avatar.webp')} alt="qinghe 的头像" width="256" height="256"/><span><UserRound size={34}/></span></a><h2>{site.name}</h2><div class="f-profile-rule"></div><p>{site.description}</p><div class="f-profile-links"><a href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><CodeXml size={21}/></a><a href={`mailto:${site.email}`} aria-label="发送邮件"><Mail size={21}/></a><a href={url('rss.xml')} aria-label="RSS 订阅"><Rss size={21}/></a></div></section>
    <section class="f-panel f-category-widget"><h2>分类</h2><div>{categories.map(category => <a href={categoryUrl(category)}><span><Folder size={15}/>{category}</span><small>{posts.filter(post => post.data.category === category).length}</small></a>)}</div></section>
    <section class="f-panel"><h2>标签</h2><div class="f-tag-cloud">{tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div></section>
  </aside>
  <main id="main-content" class="feed f-feed">
    <h2 class="sr-only" id="writings">文章列表</h2>
    <div class="f-category-bar" role="group" aria-label="筛选文章分类"><button type="button" data-category-filter="all" aria-pressed="true" aria-label="全部文章"><House size={19}/></button><a href={url('archives/')}><Archive size={16}/><span>归档</span><small>{posts.length}</small></a><span class="f-bar-divider"></span><div class="f-filter-scroll">{categories.map(category => <button type="button" data-category-filter={category} aria-pressed="false">{category}<small>{posts.filter(post => post.data.category === category).length}</small></button>)}</div><a class="f-category-more" href={url('categories/')} aria-label="查看所有分类"><ChevronRight size={20}/></a></div>
    <div class="post-grid f-posts" data-post-list>{posts.map(post => <article class:list={['post-card f-post', {'f-no-cover': !post.data.cover}]} data-category={post.data.category} data-post-key={post.id}>
      <div class="f-post-body"><h3><a href={getPostUrl(post)}>{post.data.title}</a></h3><div class="f-meta">{post.data.example && <span class="f-example">示例</span>}<span><CalendarDays size={16}/><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published, true)}</time></span><a href={categoryUrl(post.data.category)}><BookOpen size={16}/>{post.data.category}</a></div><p class="f-excerpt">{post.data.description}</p><div class="f-post-bottom"><div class="f-post-tags">{post.data.tags.slice(0, 3).map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div><span class="f-reading"><Clock3 size={12}/>{readingTime(post.body)}</span></div></div>
      {post.data.cover ? <a class="f-post-image" href={getPostUrl(post)} tabindex="-1" aria-hidden="true"><img src={url(post.data.cover)} alt="" width="800" height="500" loading="lazy" decoding="async"/><span><ChevronRight size={40}/></span></a> : <a class="f-post-enter" href={getPostUrl(post)} aria-label={`阅读：${post.data.title}`}><ChevronRight size={30}/></a>}
    </article>)}</div>
    <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>
    <a class="f-archive-link" href={url('archives/')}>全部文章<ArrowUpRight size={16}/></a>
  </main>
  <aside class="f-right" aria-label="最近更新与站点信息">
    <section class="f-panel f-updates"><h2>最近更新</h2>{posts.slice(0, 2).map(post => <a href={getPostUrl(post)}><time datetime={post.data.published.toISOString()}><Clock3 size={13}/>{formatDate(post.data.published, true)}</time><p>{post.data.title}</p>{post.data.example && <small>示例文章</small>}</a>)}<a class="f-widget-more" href={url('archives/')}><Files size={15}/>更多文章 ({posts.length})</a></section>
    <section class="f-panel f-statistics"><h2>站点统计</h2><a href={url('archives/')}><span><BookOpen size={16}/>文章</span><strong>{posts.length}</strong></a><a href={url('categories/')}><span><Folder size={16}/>分类</span><strong>{categories.length}</strong></a><a href={url('tags/')}><span><Tags size={16}/>标签</span><strong>{tags.length}</strong></a></section>
    <section class="f-panel f-site-info"><h2>关于本站</h2><p>{site.description}</p><a href={url('about/')}>认识 qinghe<ChevronRight size={15}/></a><a href={url('rss.xml')}>订阅文章<Rss size={15}/></a></section>
    <a class="f-theme-credit" href="https://github.com/CuteLeaf/Firefly" target="_blank" rel="noopener noreferrer">布局参考 Firefly<ArrowUpRight size={12}/></a>
  </aside>
</div>
<script>import '../../scripts/reference-typewriter';</script>
