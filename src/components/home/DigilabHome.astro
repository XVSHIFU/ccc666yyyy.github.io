---
import { ArrowDown, ArrowUpRight } from '@lucide/astro';
import { getPosts, getPostUrl, formatDate, categoryUrl } from '../../lib/content';
import { site, url } from '../../lib/site';
const posts = await getPosts();
---
<main id="main-content" class="feed digilab-home"><digilab-chapters>
  <section class="digilab-intro" aria-labelledby="home-title">
    <img class="digilab-nature" src={url('media/landscape.webp')} alt="" width="1983" height="793" fetchpriority="high"/>
    <div class="digilab-intro-copy"><h1 id="home-title">捕捉生活里<br/>细微的回响。</h1><p>{site.description}</p></div>
    <div class="digilab-wave" aria-hidden="true">{Array.from({length:53},(_,i)=><span style={`--wave-height:${12 + Math.abs(Math.sin(i * .42) * Math.cos(i * .17))*80}%`}></span>)}</div>
    <a class="digilab-discover" href="#digilab-writings">听见文字 <ArrowDown size={18}/></a>
  </section>
  <section class="digilab-statement"><p>把好奇变成实践。<br/>把经历写成文章。<br/><span>这里是 {site.name} 的记录。</span></p><svg viewBox="0 0 160 160" aria-hidden="true"><path d="M15 80h130M80 15v130M34 34l92 92M34 126l92-92" fill="none" stroke="currentColor" stroke-width="7"/></svg></section>
  <section id="digilab-writings" class="digilab-writings" aria-labelledby="digilab-title"><h2 id="digilab-title">最近的回响</h2><div data-post-list>{posts.map((post,index)=><article class="post-card digilab-entry" data-category={post.data.category} data-post-key={post.id}>
    <div class="digilab-entry-meta"><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published,true)}</time><a href={categoryUrl(post.data.category)}>{post.data.category}</a></div>
    <div class="digilab-entry-copy"><h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>{post.data.example && <span class="example-badge">示例文章</span>}<p>{post.data.description}</p><a class="digilab-read" href={getPostUrl(post)}>阅读全文 <ArrowUpRight size={19}/></a></div>
    <a class="digilab-entry-image" href={getPostUrl(post)} tabindex="-1" aria-hidden="true"><img src={url(post.data.cover || (index % 2 ? 'media/spring.webp':'media/landscape.webp'))} alt="" width="640" height="520" loading="lazy"/></a>
  </article>)}</div></section>
  <section class="digilab-contact"><h2>保持好奇。<br/>保持联系。</h2><a href={`mailto:${site.email}`}>写封邮件 <ArrowUpRight size={23}/></a></section>
</digilab-chapters></main>
<script>
  if(!customElements.get('digilab-chapters'))customElements.define('digilab-chapters',class extends HTMLElement{
    controller?:AbortController;frame=0;animations:Animation[]=[];timer?:ReturnType<typeof setTimeout>;
    connectedCallback(){
      this.controller?.abort();this.controller=new AbortController();const {signal}=this.controller;const intro=this.querySelector<HTMLElement>('.digilab-intro');const nature=this.querySelector<HTMLElement>('.digilab-nature');const copy=this.querySelector<HTMLElement>('.digilab-intro-copy');const chapter=this.querySelector<HTMLElement>('.digilab-statement');const discover=this.querySelector<HTMLAnchorElement>('.digilab-discover');if(!intro||!nature||!copy||!chapter||!discover)return;const reduce=matchMedia('(prefers-reduced-motion: reduce)');let entering=false,px=0,py=0;
      const render=()=>{this.frame=0;if(!this.isConnected)return;const r=intro.getBoundingClientRect();const progress=reduce.matches?0:Math.max(0,Math.min(1,-r.top/r.height));intro.style.setProperty('--scene-scale',String(1.04+progress*.2));intro.style.setProperty('--scene-x',`${px*22}px`);intro.style.setProperty('--scene-y',`${py*16+progress*65}px`);intro.style.setProperty('--scene-tilt',`${progress*5}deg`);intro.style.setProperty('--wave-shift',`${progress*28}px`);const rect=chapter.getBoundingClientRect();const fill=reduce.matches?1:Math.max(0,Math.min(1,(innerHeight-rect.top)/(innerHeight*.85)));chapter.style.setProperty('--chapter-fill',`${fill*100}%`);chapter.style.setProperty('--chapter-turn',`${reduce.matches?0:(1-fill)*-45}deg`);intro.dataset.motionReady='true'};
      const schedule=()=>{if(!this.frame)this.frame=requestAnimationFrame(render)};
      const reset=()=>{this.animations.forEach(animation=>animation.cancel());this.animations=[];entering=false;intro.removeAttribute('data-entering')};
      discover.addEventListener('click',event=>{if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||event.button!==0)return;if(reduce.matches)return;event.preventDefault();if(entering)return;entering=true;intro.dataset.entering='true';const options={duration:850,easing:'cubic-bezier(.16,1,.3,1)',fill:'forwards' as FillMode};this.animations=[nature.animate([{transform:getComputedStyle(nature).transform},{transform:'translate3d(0,35px,0) scale(1.33) rotateX(7deg)'}],options),copy.animate([{opacity:1,transform:'translateY(0)'},{opacity:0,transform:'translateY(-55px)'}],{...options,duration:550})];this.timer=setTimeout(()=>{if(!this.isConnected)return;chapter.scrollIntoView({behavior:'smooth',block:'start'});this.timer=setTimeout(reset,650)},320)},{signal});
      intro.addEventListener('pointermove',event=>{if(reduce.matches||event.pointerType!=='mouse')return;const box=intro.getBoundingClientRect();px=(event.clientX-box.left)/box.width-.5;py=(event.clientY-box.top)/box.height-.5;schedule()},{signal});intro.addEventListener('pointerleave',()=>{px=0;py=0;schedule()},{signal});window.addEventListener('scroll',schedule,{signal,passive:true});window.addEventListener('resize',schedule,{signal});reduce.addEventListener('change',()=>{px=0;py=0;if(this.timer)clearTimeout(this.timer);reset();schedule()},{signal});render();
    }
    disconnectedCallback(){this.controller?.abort();cancelAnimationFrame(this.frame);this.frame=0;if(this.timer)clearTimeout(this.timer);this.animations.forEach(animation=>animation.cancel());this.animations=[];}
  });
</script>
