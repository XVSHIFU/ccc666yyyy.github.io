---
import { ArrowDown, ArrowRight, CodeXml as Github, Mail, Rss, Folder, CalendarDays, Tags, BookOpen } from '@lucide/astro';
import { getPosts, getPostUrl, formatDate, categoryUrl, tagUrl } from '../../lib/content';
import { site, url } from '../../lib/site';
const posts = await getPosts();
const categories = [...new Set(posts.map(post => post.data.category))];
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<redefine-motion class="redefine-home">
  <div class="redefine-backdrop" data-theme-cover={url('media/landscape.webp')} aria-hidden="true"></div>
  <section class="redefine-banner" aria-labelledby="home-title">
    <div class="redefine-banner-copy">
      <h1 id="home-title">{site.title}</h1>
      <p><reference-typewriter class="redefine-typewriter" data-text={site.description} data-speed="100" data-delete="80" data-start="500" data-pause="1500" data-loop="true"><span class="redefine-text-measure" aria-hidden="true">{site.description}</span><span class="redefine-typed" data-typed-output aria-hidden="true">{site.description}</span><span class="sr-only">{site.description}</span></reference-typewriter></p>
    </div>
    <div class="redefine-banner-bottom">
      <a class="redefine-scroll" href="#writings" aria-label="向下阅读文章"><ArrowDown size={22}/></a>
      <div class="redefine-social" aria-label="联系与订阅">
        <a href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Github size={21}/></a>
        <a href={`mailto:${site.email}`} aria-label="电子邮件"><Mail size={21}/></a>
        <a href={url('rss.xml')} aria-label="RSS 订阅"><Rss size={20}/></a>
      </div>
    </div>
  </section>
  <div class="redefine-layout" id="writings">
    <aside class="redefine-sidebar" aria-label="作者与分类">
      <section class="redefine-author">
        <a href={url('about/')} aria-label="认识 qinghe"><img src={url('media/avatar.webp')} alt="qinghe 的头像" width="80" height="80" loading="lazy"/></a>
        <h2>{site.name}</h2>
        <p>{site.description}</p>
        <div class="redefine-statistics">
          <a href={url('tags/')}><strong>{tags.length}</strong><span>标签</span></a>
          <a href={url('categories/')}><strong>{categories.length}</strong><span>分类</span></a>
          <a href={url('archives/')}><strong>{posts.length}</strong><span>文章</span></a>
        </div>
      </section>
      <nav class="redefine-menu" aria-label="探索小站">
        <h2>{site.title}</h2>
        <a href={url('archives/')}><BookOpen size={17}/><span>所有文章</span><small>{posts.length}</small></a>
        {categories.map(category => <a href={categoryUrl(category)}><Folder size={17}/><span>{category}</span><small>{posts.filter(post => post.data.category === category).length}</small></a>)}
        <a href={url('tags/')}><Tags size={17}/><span>标签</span><ArrowRight size={14}/></a>
      </nav>
    </aside>
    <main id="main-content" class="feed redefine-feed">
      <h2 class="sr-only">最近的文章</h2>
      <div class="redefine-posts" data-post-list>
        {posts.map(post => <article class="post-card redefine-post" data-category={post.data.category} data-post-key={post.id}>
          {post.data.cover && <a class="post-cover" href={getPostUrl(post)} tabindex="-1" aria-hidden="true"><img src={url(post.data.cover)} alt="" width="900" height="220" loading="lazy" decoding="async"/></a>}
          <div class="post-card-body">
            <h3 class="post-card-title"><a href={getPostUrl(post)}>{post.data.title}</a>{post.data.example && <span class="example-badge">示例</span>}</h3>
            <p class="post-excerpt">{post.data.description}</p>
            <div class="redefine-post-bottom">
              <div class="post-meta"><span><CalendarDays size={14}/><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published, true)}</time></span><a href={categoryUrl(post.data.category)}><Folder size={14}/>{post.data.category}</a><div class="post-tags">{post.data.tags.slice(0, 2).map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div></div>
              <a class="post-read-link" href={getPostUrl(post)} aria-label={`阅读全文：${post.data.title}`}>阅读全文<ArrowRight size={15}/></a>
            </div>
          </div>
        </article>)}
      </div>
      <p class="redefine-feed-end">已经到这里了，明天再写一点。</p>
    </main>
  </div>
</redefine-motion>
<script>
  import '../../scripts/reference-typewriter';
  // Source mechanism: Redefine source/js/layouts/navbarShrink.js. Independently authored.
  class RedefineMotion extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller = new AbortController();
      const sync = () => { document.documentElement.dataset.redefineShrink = String(scrollY > 70); };
      window.addEventListener('scroll', sync, { passive: true, signal: this.controller.signal });
      sync();
    }
    disconnectedCallback() { this.controller?.abort(); delete document.documentElement.dataset.redefineShrink; }
  }
  if (!customElements.get('redefine-motion')) customElements.define('redefine-motion', RedefineMotion);
</script>
